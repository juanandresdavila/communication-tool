# Cadena de conexión de Postgres: en local, una base descartable; en producción,
# la del contenedor del VPS.
# Formato: postgres://usuario:password@host:5432/dbname
# Es lo único que necesita `bun run db:migrate`.
DATABASE_URL=

# Bearer que exige /internal/*. Lo presenta el ticker externo.
# Al menos 32 caracteres. Generar con: openssl rand -hex 32
INTERNAL_SECRET=

# Secretos referenciados DESDE LA BASE por nombre: `bots.token_env`,
# `bots.webhook_secret_env` y `apps.delivery_secret_env` guardan estos
# nombres, nunca sus valores. Cada bot y cada app suma los suyos.
#
# OJO: `createSecretReader` no deja pasar un `[SENSITIVE]` (el literal que dejaba
# un `vercel env pull` viejo): falla en la lectura, nombrando la variable. En
# local se generan a mano; el token del bot sale de BotFather.
TELEGRAM_TOKEN_GYM=
TELEGRAM_WEBHOOK_SECRET_GYM=
DELIVERY_SECRET_GYM=

# NO es un secreto de comm-tool: es la API key de la app consumidora, que acá
# solo se guarda hasheada en `apps.api_key_hash`. Va en el .env local nada más
# para poder probar los endpoints /v1 a mano. Regenerarla con:
#   KEY="$(openssl rand -hex 24)" && echo "GYM_API_KEY=$KEY" >> .env \
#     && bun run scripts/registrar-app.ts "$KEY"
GYM_API_KEY=
