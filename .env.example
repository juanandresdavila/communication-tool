# Cadena de conexión de Neon.
# Formato: postgres://usuario:password@host.neon.tech/dbname?sslmode=require
# En Vercel se carga desde el dashboard, no desde este archivo.
# Es lo único que necesita `bun run db:migrate`.
DATABASE_URL=

# Bearer que exige /internal/*. Lo presenta el ticker externo.
# Generar con: openssl rand -hex 32
INTERNAL_SECRET=

# Secretos referenciados DESDE LA BASE por nombre: `bots.token_env`,
# `bots.webhook_secret_env` y `apps.delivery_secret_env` guardan estos
# nombres, nunca sus valores. Cada bot y cada app suma los suyos.
TELEGRAM_TOKEN_GYM=
TELEGRAM_WEBHOOK_SECRET_GYM=
DELIVERY_SECRET_GYM=
