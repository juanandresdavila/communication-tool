# Cadena de conexión de Neon.
# Formato: postgres://usuario:password@host.neon.tech/dbname?sslmode=require
# En Vercel se carga desde el dashboard, no desde este archivo.
# Es lo único que necesita `bun run db:migrate`.
DATABASE_URL=

# Bearer que exige /internal/*. Lo presenta el ticker externo.
# Generar con: openssl rand -hex 32
INTERNAL_SECRET=

# Secretos referenciados DESDE LA BASE por nombre: `bots.token_env`,
# `bots.webhook_secret_env` y `apps.delivery_secret_env` guardan estos
# nombres, nunca sus valores. Cada bot y cada app suma los suyos.
#
# OJO: estos tres, y también INTERNAL_SECRET, están marcados como sensibles en
# Vercel. `vercel env pull` los devuelve como el literal `[SENSITIVE]`, no como
# su valor. Y `createSecretReader` los deja pasar porque solo valida contra
# vacío, así que el error aparece recién como un 502 de Telegram. Para probar
# en local hay que cargarlos a mano desde su fuente original.
TELEGRAM_TOKEN_GYM=
TELEGRAM_WEBHOOK_SECRET_GYM=
DELIVERY_SECRET_GYM=

# NO es un secreto de comm-tool: es la API key de la app consumidora, que acá
# solo se guarda hasheada en `apps.api_key_hash`. Va en el .env local nada más
# para poder probar los endpoints /v1 a mano. `vercel env pull` pisa el archivo
# y se la lleva puesta; regenerarla con:
#   KEY="$(openssl rand -hex 24)" && echo "GYM_API_KEY=$KEY" >> .env \
#     && bun run scripts/registrar-app.ts "$KEY"
GYM_API_KEY=
