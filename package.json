{
  "name": "communication-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./conformance": {
      "types": "./dist/client/conformance.d.ts",
      "default": "./dist/client/conformance.js"
    }
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "bun run src/db/migrate.ts",
    "build:client": "tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/functions": "^3.7.6",
    "croner": "^10.0.1",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "^6",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
